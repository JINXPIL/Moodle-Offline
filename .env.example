# Скопируйте этот файл в .env и заполните нужное. Всё необязательно — программа спросит сама.
MOODLE_URL=https://do.sevsu.ru
MOODLE_USERNAME=
# Пароль лучше НЕ хранить здесь: программа спросит его при входе
# или запомнит в зашифрованном виде (галочка «Запомнить меня»).
MOODLE_PASSWORD=
# Вход без пароля (единый вход/SSO): значение cookie MoodleSession из браузера
MOODLE_COOKIE=
# Тихие часы: качать только в это время
MOODLE_HOURS=
# Версия Chrome в заголовках (по умолчанию 142) или полностью свой User-Agent
MOODLE_CHROME_VERSION=
MOODLE_USER_AGENT=
# Путь к Edge/Chrome для PDF, если стоит в нестандартном месте
MOODLE_BROWSER=
